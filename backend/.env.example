# ============================================================
# URDiary 後端環境設定範本（全部可選——零設定即可啟動）
# 需要客製化時複製為 .env：  cp .env.example .env
# ============================================================

# 執行環境: development / production
ENV=development

# ---------- LLM 供應商 ----------
# 主路徑：使用者在前端「設定」面板填入各家 API Key（safeStorage 加密存本機，
# 隨請求以 X-LLM-* 標頭送到本機後端，不寫入任何伺服器）。
# XAI_API_KEY 只是「前端未設定供應商時」的可選 Grok 後備，可留空。
#GROK_API_URL=https://api.x.ai/v1
#XAI_API_KEY=
#FALLBACK_GROK_MODEL=grok-4.3

# ---------- 安全金鑰 ----------
# 留空即可：首次啟動會自動生成並持久化到 data/secrets.json（0600 權限）。
# 只有想自行管理金鑰時才需要設定這些值（env 永遠優先於 secrets.json）。
#SECRET_KEY=
#HASH_SALT=
#TOKEN_EXPIRE_MINUTES=1440

# ---------- 本地資料 ----------
# 資料目錄（SQLite 資料庫 + secrets.json），預設為專案根目錄 data/
#URDIARY_DATA_DIR=

# 時區（日記的「今天」以此為準，凌晨 5 點換日）。
# 注意：中途變更不會換算既有日記的日期，建議安裝時一次決定。
#URDIARY_TIMEZONE=Asia/Taipei
#URDIARY_DAY_BOUNDARY_HOUR=5

# ---------- API 服務 ----------
# 後端埠號（預設 8001）
#API_PORT=8001

# CORS 允許來源（逗號分隔；桌面 App 走 file:// 不受此限制）
#CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
